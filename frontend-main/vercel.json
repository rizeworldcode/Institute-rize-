{
  "trailingSlash": false,
  "redirects": [
    {
      "source": "https://www.rizeworldinstitute.in/:path*",
      "destination": "https://rizeworldinstitute.in/:path*",
      "permanent": true
    },
    {
      "source": "/alwar-rj",
      "destination": "/location/alwar",
      "permanent": true
    },
    {
      "source": "/alwar-rj/",
      "destination": "/location/alwar",
      "permanent": true
    },
    {
      "source": "/centers",
      "destination": "/location",
      "permanent": true
    },
    {
      "source": "/centers/",
      "destination": "/location",
      "permanent": true
    }
  ],
  "routes": [
    { "handle": "filesystem" },
    {
      "src": "^/(|courses|master-course|hire-from-us|about|blog|blog/.+|contact|location|location/alwar|seo|social-media-marketing|performance-marketing|website-development|graphic-design|video-editing|ai-digital-marketing|privacy|terms|certificate|student_login|trainers|alwar-rj|centers)/?$",
      "dest": "/index.html",
      "status": 200
    },
    {
      "src": "/(.*)",
      "dest": "/index.html",
      "status": 404
    }
  ]
}
